# Server B config (aplikasi ini)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_PERSIST_DIR=./data/vectorstore
CONTEXT_WINDOW_TOKENS=8192

# Auth — token yang harus dikirim Server A (medinovav2) di header Authorization: Bearer <token>
API_AUTH_TOKEN=

# Batas concurrency (lihat ROADMAP.md §3 — Mac Mini 16GB, dibatasi 1 request pada satu waktu)
MAX_CONCURRENT_REQUESTS=1

# MySQL — audit log traffic LLM untuk dashboard/ (lihat dashboard/README.md).
# Database terpisah dari MySQL milik medinovav2, HANYA metadata traffic (tidak
# ada data pasien) — dijalankan di Server B yang sama dengan FastAPI/Ollama.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=medinova_rag_logs
MYSQL_USER=rag_dashboard
MYSQL_PASSWORD=

# Dashboard Django (dashboard/)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
